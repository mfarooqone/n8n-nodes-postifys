{
  "name": "n8n-nodes-postifys",
  "version": "0.6.21",
  "description": "n8n community node for Postifys (postifys.com): publish to Facebook, Instagram, YouTube, Pinterest, LinkedIn, and TikTok via API/n8n.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "postifys",
    "facebook",
    "instagram",
    "youtube",
    "pinterest",
    "linkedin",
    "tiktok",
    "social media"
  ],
  "license": "MIT",
  "homepage": "https://postifys.com",
  "author": {
    "name": "Postifys"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mfarooqone/n8n-nodes-postifys.git"
  },
  "main": "dist/nodes/Postifys/Postifys.node.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/nodes/Postifys && cp nodes/Postifys/postifys.svg dist/nodes/Postifys/postifys.svg",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node scripts/smoke-test.js",
    "test": "npm run smoke",
    "lint": "npm run typecheck",
    "release:check": "npm run test && npm pack --dry-run",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/PostifysApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Postifys/Postifys.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "n8n-workflow": "^1.82.0",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
